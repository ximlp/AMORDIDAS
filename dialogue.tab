bosqueUI_label_e759553f	nvle	Adara, Helena y Chancho llegan a la primera X marcada en el mapa, ven una fábrica abandonada.	game/script.rpy	1364	nvle "[what]"
bosqueUI_label_c6476601	ad	¿Estás segura de esto? No sabemos que hay aquí.	game/script.rpy	1366	ad "[what]"
