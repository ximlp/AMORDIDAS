inputt_label_10af547c	he	Yo a ti.	game/script.rpy	1545	he "[what]"
inputt_label_9bae24c7	nvle	Adara continua navegando entre carpetas.	game/script.rpy	1547	nvle "[what]"
inputt_label_260277fb	he	Son los mismos símbolos. Están en el mapa original. Todos son sitios de Elodia...	game/script.rpy	1550	he "[what]"
